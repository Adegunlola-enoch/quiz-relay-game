# Local server port
PORT=3001

# Use the same origin in development. Set to https://your-game.vercel.app in production.
CLIENT_ORIGIN=http://localhost:5173

# Optional. Enables fetching additional questions from Open Trivia DB.
QUESTION_API_ENABLED=true

# Production Vercel note: use a shared Redis-backed room store before scaling beyond one instance.
# REDIS_URL=
